generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model QuableInstance {
  id          Int           @id @default(autoincrement())
  name        String
  authToken   String
  quableAppId String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("quable_instance")
}

model SlotSession {
  id              String   @id @default(uuid())
  slot            String
  instanceName    String?
  instanceUrl     String?
  userEmail       String?
  userAdmin       Boolean  @default(false)
  objectType      String?
  objectIds       String?
  dataLocale      String?
  interfaceLocale String?
  createdAt       DateTime @default(now())

  @@map("slot_session")
}
